<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Mascota"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etEditarNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la mascota"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Especie:"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spEditarEspecie"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/etEditarEdad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Edad (en años)"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <CheckBox
            android:id="@+id/cbEditarVacunado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Está vacunado?"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado de adopción:"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spEditarEstado"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/etEditarDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción"
            android:inputType="textMultiLine"
            android:lines="3"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualizar Cambios"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
